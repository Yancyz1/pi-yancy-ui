{
	"name": "pi-yancy-ui",
	"version": "0.1.0",
	"description": "Claude Code-style folding of Pi's thinking blocks and tool calls.",
	"type": "module",
	"license": "MIT",
	"author": "yancyz1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yancyz1/pi-yancy-ui.git"
	},
	"homepage": "https://github.com/Yancyz1/pi-yancy-ui#readme",
	"bugs": {
		"url": "https://github.com/Yancyz1/pi-yancy-ui/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"claude-code",
		"folding",
		"tui"
	],
	"files": [
		"extensions",
		"docs",
		"README.md",
		"README.zh-CN.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"extensions/yancy-ui/index.ts"
		]
	},
	"scripts": {
		"dev": "pi --no-extensions -e ./extensions/yancy-ui/index.ts",
		"smoke": "node smoke.mjs",
		"test": "node test.mjs",
		"bench": "node bench.mjs",
		"verify:host": "node verify-host.mjs",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
